# Firebase Configuration (for frontend application)
VITE_FIREBASE_AUTH_ENABLED=true
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id
VITE_CLOUDFLARE_WORKER_URL=https://your-worker.workers.dev
VITE_PROXY_URL=https://your-cors-proxy.workers.dev/

# Deployment Configuration
DEPLOY_BASE_DOMAIN=mcptest.io
DEPLOY_BASE_DIR=/var/www/mcptest
DEPLOY_REPO_URL=git@github.com:integry/mcptest.git
DEPLOY_MAIN_BRANCH=master
DEPLOY_BRANCH_SUBDOMAIN_PREFIX=dev-

# Webhook Configuration
WEBHOOK_PORT=8081
WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_TOKEN=your_github_personal_access_token

# Repository Configuration
REPO_OWNER=integry
REPO_NAME=mcptest

# Application Configuration
APP_NAME=mcp-webhook-listener
NODE_ENV=production

# PM2 Configuration
PM2_LOG_DIR=~/.pm2/logs
PM2_MAX_RESTARTS=10
PM2_MIN_UPTIME=5000

# Directory Structure
REPO_CLONE_DIR=${DEPLOY_BASE_DIR}/repo
MAIN_SITE_DIR=${DEPLOY_BASE_DIR}/main
BRANCHES_BASE_DIR=${DEPLOY_BASE_DIR}/branches

# Deployment Environment
DEFAULT_DEPLOY_ENV=development
PRODUCTION_BRANCHES=master,main